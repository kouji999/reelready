{
  "name": "reelready",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "reelready",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22.5"
      }
    },
    "apps/server": {
      "name": "@reelready/server",
      "version": "0.1.0"
    },
    "apps/web": {
      "name": "@reelready/web",
      "version": "0.1.0"
    },
    "node_modules/@reelready/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@reelready/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@reelready/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/engine": {
      "name": "@reelready/engine",
      "version": "0.1.0",
      "bin": {
        "reelready": "src/cli.js"
      }
    }
  }
}
